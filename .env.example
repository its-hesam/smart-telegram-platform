DATABASE_URL=postgresql://smart:change-me@localhost:5432/smart?schema=public
POSTGRES_USER=smart
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smart
REDIS_URL=redis://localhost:6379
API_PORT=3001
LOG_LEVEL=info
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Required: independent 32-byte random keys encoded as 64 hex characters.
DATA_ENCRYPTION_KEY=
IDENTITY_HMAC_KEY=
SESSION_TTL_SECONDS=28800
# Set ADMIN_EMAIL and ADMIN_PASSWORD only for npm run admin:create; remove afterward.
WORKER_PROBE_INTERVAL_MS=15000
PROFILE_ARCHIVE_ROOT=./profiles/encrypted
PROFILE_RUNTIME_ROOT=./profiles/runtime
WORKER_LOGIN_URL=http://127.0.0.1:3002
# Independent 32-byte random hex key. Production runtime must be Linux tmpfs.
PROFILE_ENCRYPTION_KEY=
TELEGRAM_MUTATIONS_ENABLED=false
ACTION_INTERVAL_MS=30000
QUEUE_MAX_PENDING=5000
EXPORT_ROOT=./exports
EXPORT_BATCH_SIZE=500
IMPORT_MAX_ROWS=5000
WORKER_DISPATCH_BATCH=500
WORKER_MAINTENANCE_MS=15000
# SELECTOR_REGISTRY_PATH must point to an authorized, verified registry before enabling mutations.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://collector:4318/v1/traces
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/events
# Production only: pre-provision a least-privilege DB role after migration.
# APP_DATABASE_URL=postgresql://smart_app:URL_SAFE_PASSWORD@postgres:5432/smart?schema=public
# TLS_CERT_DIR=/secure/path/to/certificates
# Development only. Production requires HTTPS and managed secrets.
