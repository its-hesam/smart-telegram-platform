{
  "name": "smart-telegram-platform",
  "version": "0.3.12",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "demo:stop": "node scripts/demo-stop.mjs",
    "test:restore": "node --env-file=.env --import tsx tests/recovery/database-restore.ts",
    "cleanup": "node --env-file=.env --import tsx apps/worker/src/cleanup.ts",
    "owner:login": "node --env-file=.env --import tsx apps/worker/src/owner-login.ts",
    "test:browser": "vitest run tests/browser",
    "admin:create": "node --env-file=.env --import tsx apps/api/src/create-admin.ts",
    "build": "npm run db:generate && tsc -p tsconfig.build.json && npm run build -w @smart/web",
    "typecheck": "npm run db:generate && tsc --noEmit && npm run typecheck -w @smart/web",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "dev:web": "npm run dev -w @smart/web",
    "dev:api": "node --env-file=.env --import tsx apps/api/src/main.ts",
    "dev:worker": "node --env-file=.env --import tsx apps/worker/src/main.ts",
    "db:generate": "prisma generate --config packages/database/prisma.config.ts",
    "db:validate": "prisma validate --config packages/database/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config packages/database/prisma.config.ts",
    "infra:up": "docker compose up -d --wait postgres redis"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "argon2": "0.45.2",
    "bullmq": "6.7.0",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "dotenv": "18.0.9",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "playwright": "1.65.0",
    "read-excel-file": "9.3.14",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tar": "7.5.22",
    "ws": "8.22.1",
    "zod": "4.6.7",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
