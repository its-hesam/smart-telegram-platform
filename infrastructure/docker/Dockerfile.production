FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY . .
RUN npm ci
# npm 12 blocks dependency install scripts by default; rebuild the native and
# Prisma binaries explicitly so the runtime image contains them.
RUN npm rebuild argon2 @prisma/engines prisma esbuild msgpackr-extract
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM build AS migrate
USER node
CMD ["npm", "run", "db:migrate"]

FROM build AS production-dependencies
RUN npm prune --omit=dev

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY --from=production-dependencies /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./dist
COPY --from=build /app/apps/web/.next ./apps/web/.next
COPY --from=build /app/apps/web/public ./apps/web/public
COPY --from=build /app/apps/web/package.json ./apps/web/package.json
COPY --from=build /app/apps/web/next.config.mjs ./apps/web/next.config.mjs
COPY --from=build /app/packages ./packages
RUN node node_modules/playwright/cli.js install --with-deps chromium && mkdir -p /profiles/encrypted /profiles/runtime /exports && chown -R node:node /profiles /exports /app/apps/web/.next
USER node
EXPOSE 3000 3001
CMD ["node", "dist/apps/api/src/main.js"]
